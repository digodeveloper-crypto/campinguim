# Verificação do aparelho em PRODUÇÃO: só os NOMES e os valores que não são segredo.
# Modelo para o servidor hospedado (F0-6 em diante). Um teste automático lê este arquivo e
# confere que a prova de desenvolvimento e o dublê de teste ficam desligados.
# A chave da conta de serviço do Google Cloud NUNCA entra aqui: vai direto para o cofre de
# segredos do serviço (CLAUDE.md, Segurança).
AMBIENTE=producao
# Nome definitivo do pacote Android (decisão H6 do responsável, antes da F0-6).
VERIFICACAO_PACOTE=
# Resumo SHA-256 do certificado de assinatura de apps da Play (Play Console), separado por vírgula.
VERIFICACAO_CERTIFICADOS_SHA256=
# PREMISSAS da prova (a SPEC diz só "tempo limitado"); valor final é decisão do responsável.
VERIFICACAO_IDADE_MAXIMA_TOKEN_S=300
VERIFICACAO_TOLERANCIA_FUTURO_S=60
VERIFICACAO_VALIDADE_APARELHO_H=24
